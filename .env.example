# MySQL root credential. 실제 secret은 local .env 또는 secret manager에서 주입한다.
MYSQL_ROOT_PASSWORD=
# Application MySQL schema.
MYSQL_DATABASE=
# Application MySQL credential.
MYSQL_USER=
MYSQL_PASSWORD=
# mysqld-exporter 전용 credential.
MYSQL_EXPORTER_USER=
MYSQL_EXPORTER_PASSWORD=

# Redis consumer identity와 각 Worker HTTP port.
WORKER1_NAME=worker-1
WORKER1_PORT=8085
WORKER2_NAME=worker-2
WORKER2_PORT=8086

# 배포 image reference. 개발 시 deploy/images.dev.env를 함께 사용한다.
BIP_INGEST_IMAGE=
BIP_PROCESSING_IMAGE=
BIP_SCANNER_IMAGE=
BIP_PERSISTENCE_WORKER_IMAGE=
